@page "/admin"
@model TodoManager.Pages.Admin.IndexModel
@{
ViewData["Title"] = "Admin Panel";
}

<h1>Admin Panel</h1>

<table class="table">
	<thead>
		<tr>
			<th>Имя</th>
			<th>Email</th>
			<th>Роли</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var user in Model.Users)
		{
		<tr>
			<td>@user.FullName</td>
			<td>@user.Email</td>
			<td>@user.Roles</td>
		</tr>
		}
	</tbody>
</table>

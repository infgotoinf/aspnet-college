@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Antiforgery
@using TodoManager.Models
@inject UserManager<AppUser> UserManager
@inject IAntiforgery Antiforgery
@{
    AppUser? currentUser = null;
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}
<!DOCTYPE html>
<html lang="ru">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="csrftoken" content="@csrfToken">
		<title>@ViewData["Title"] - TodoManager</title>
		<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
		<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
		<link rel="stylesheet" href="~/TodoManager.styles.css" asp-append-version="true">
	</head>
	<body>
		<header>
			<nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
				<div class="container">
					<a class="navbar-brand" asp-page="/Index">TodoManager</a>

					<div class="navbar-collapse">
						<ul class="navbar-nav me-auto">
							<li class="nav-item">
								<a class="nav-link text-dark" asp-page="/Index">Главная</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-dark" asp-page="/Privacy">Privacy</a>
							</li>
							@if (User.Identity?.IsAuthenticated == true)
							{
								<li class="nav-item">
									<a class="nav-link text-dark" asp-page="/Tasks/Index">Мои задачи</a>
								</li>
								<li class="nav-item">
									<a class="nav-link text-dark" asp-page="/Tasks/Create">Создать задачу</a>
								</li>

								@if (User.IsInRole("Admin"))
								{
									<li class="nav-item">
										<a class="nav-link text-dark" asp-page="/Admin/Index">Admin Panel</a>
									</li>
								}
							}
						</ul>

						<ul class="navbar-nav">
							@if (User.Identity?.IsAuthenticated == true)
							{
								<li class="nav-item">
									<span class="nav-link">@currentUser?.FullName</span>
								</li>
								<li class="nav-item">
									<form method="post" asp-page="/Account/Logout">
										<button type="submit" class="nav-link btn btn-link">Выйти</button>
									</form>
								</li>
							}
							else
							{
								<li class="nav-item">
									<a class="nav-link text-dark" asp-page="/Account/Register">Регистрация</a>
								</li>
								<li class="nav-item">
									<a class="nav-link text-dark" asp-page="/Account/Login">Вход</a>
								</li>
							}
						</ul>
					</div>
				</div>
			</nav>
		</header>

		<div class="container">
			<main role="main" class="pb-3">
				@RenderBody()
			</main>
		</div>

		<footer class="border-top footer text-muted">
			<div class="container">
				&copy; 2026 - TodoManager
			</div>
		</footer>

		<script src="~/lib/jquery/dist/jquery.min.js"></script>
		<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
		<script src="~/js/site.js" asp-append-version="true"></script>

		@await RenderSectionAsync("Scripts", required: false)
	</body>
</html>

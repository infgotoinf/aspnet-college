@page
@model TodoManager.Pages.Tasks.CreateModel
@{
ViewData["Title"] = "Создать задачу";
}

<h1>Создать задачу</h1>

<form method="post">
	<div asp-validation-summary="All" class="text-danger"></div>

	<div class="mb-3">
		<label asp-for="Input.Title" class="form-label">Название</label>
		<input asp-for="Input.Title" class="form-control">
		<span asp-validation-for="Input.Title" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Input.Description" class="form-label">Описание</label>
		<textarea asp-for="Input.Description" class="form-control"></textarea>
		<span asp-validation-for="Input.Description" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">Создать</button>
</form>

@using System.Globalization
@model asp3.Models.CartViewModel

@{
ViewData["Title"] = "Корзина";
}

<h1 class="page-title">Корзина</h1>

@if (Model.Items.Count == 0)
{
<div class="alert alert-warning alert-dismissible fade show">
	Корзина пуста.

	<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть">
	</button>
</div>
}
else
{
<div class="alert alert-success alert-dismissible fade show">
	Товар добавлен в корзину.

	<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть">
	</button>
</div>

<ul class="list-group mb-3">
	@foreach (var item in Model.Items)
	{
	<li class="list-group-item d-flex justify-content-between">
		<span>@item.Name</span>
		<strong>@item.Price.ToString("C", CultureInfo.GetCultureInfo("ru-RU"))</strong>
	</li>
	}
</ul>

<p class="fs-4">
	Итого: <strong>@Model.TotalAmount.ToString("C", CultureInfo.GetCultureInfo("ru-RU"))</strong>
</p>

<button type="button" class="btn btn-success order-button" data-bs-toggle="modal" data-bs-target="#confirmOrderModal">
	Оформить заказ
</button>

<div class="modal fade" id="confirmOrderModal" tabindex="-1" aria-hidden="true">

	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Подтверждение заказа</h5>

				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть">
				</button>
			</div>

			<div class="modal-body">
				<p>
					Вы уверены, что хотите оформить заказ на сумму
					<strong>@Model.TotalAmount.ToString("C", CultureInfo.GetCultureInfo("ru-RU"))</strong>?
				</p>

				<ul class="list-group mb-3">
					@foreach (var item in Model.Items)
					{
					<li class="list-group-item">
						@item.Name — @item.Price.ToString("C", CultureInfo.GetCultureInfo("ru-RU"))
					</li>
					}
				</ul>
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
					Отмена
				</button>

				<button type="button" class="btn btn-primary">
					Подтвердить
				</button>
			</div>
		</div>
	</div>
</div>
}

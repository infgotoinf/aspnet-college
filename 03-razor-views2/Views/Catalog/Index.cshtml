@{
ViewData["Title"] = "Каталог";
}

<h1 class="page-title">Каталог товаров</h1>

<div class="row g-4">
	<div class="col-12 col-md-6 col-lg-4">
		<div class="card h-100 shadow-sm">
			<img src="~/img/product-placeholder.jpg" class="card-img-top img-fluid" alt="Ноутбук">

			<div class="card-body d-flex flex-column">
				<span class="badge bg-danger align-self-start mb-2">
					Скидка
				</span>

				<h5 class="card-title">Ноутбук</h5>

				<p class="card-text">
					Производительный ноутбук для работы и учёбы.
				</p>

				<p class="fs-4 mt-auto">79 990 ₽</p>

				<button class="btn btn-primary">
					В корзину
				</button>
			</div>
		</div>
	</div>

	<div class="col-12 col-md-6 col-lg-4">
		<div class="card h-100 shadow-sm">
			<img src="~/img/product-placeholder.jpg" class="card-img-top img-fluid" alt="Наушники">

			<div class="card-body d-flex flex-column">
				<span class="badge bg-success align-self-start mb-2">
					Хит
				</span>

				<h5 class="card-title">Наушники</h5>

				<p class="card-text">
					Беспроводные наушники с хорошим качеством звука.
				</p>

				<p class="fs-4 mt-auto">5 990 ₽</p>

				<button class="btn btn-primary">
					В корзину
				</button>
			</div>
		</div>
	</div>

	<div class="col-12 col-md-6 col-lg-4">
		<div class="card h-100 shadow-sm">
			<img src="~/img/product-placeholder.jpg" class="card-img-top img-fluid" alt="Клавиатура">

			<div class="card-body d-flex flex-column">
				<span class="badge bg-secondary align-self-start mb-2">
					Новинка
				</span>

				<h5 class="card-title">Клавиатура</h5>

				<p class="card-text">
					Удобная клавиатура для дома и офиса.
				</p>

				<p class="fs-4 mt-auto">3 490 ₽</p>

				<button class="btn btn-primary">
					В корзину
				</button>
			</div>
		</div>
	</div>
</div>
